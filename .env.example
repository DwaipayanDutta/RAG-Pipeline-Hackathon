# Copy to `RAG_Pipeline_Graph/.env` (loaded automatically by the Graph CLI when python-dotenv is
# installed) or export these in your shell. NOTHING here is required: every pipeline runs with
# its defaults. Never commit a real .env file.

# ---------------------------------------------------------------- Graph RAG (RAG_Pipeline_Graph)
# Precedence: defaults < --config JSON < these variables < CLI flags.
# RAG_GRAPH_DB_PATH=RAG_Pipeline_Graph/sample_data/cmdb.sql   # .sql script, .sqlite/.db file or sqlite:///path
# RAG_GRAPH_WIKI_DIR=RAG_Pipeline_Graph/sample_data/wiki
# RAG_GRAPH_PDF_DIR=RAG_Pipeline_Graph/sample_data/pdfs
# RAG_GRAPH_INDEX_DIR=RAG_Pipeline_Graph/.graph_index
# RAG_GRAPH_LLM_BACKEND=extractive                            # extractive | flan-t5
# RAG_GRAPH_GENERATION_MODEL=google/flan-t5-base
# RAG_GRAPH_EMBEDDING_BACKEND=auto                            # auto | sentence-transformers | hash
# RAG_GRAPH_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# RAG_GRAPH_VECTOR_BACKEND=auto                               # auto | chroma | memory
# RAG_GRAPH_LOG_LEVEL=INFO

# ---------------------------------------------------------------- Jev + RAG (RAG_Pipeline_Jev)
# Only needed with --use-jev. Without it the Jev pipeline falls back to Standard RAG.
# TYPESAFE_API_KEY=your-typesafe-api-key

# ---------------------------------------------------------------- Hugging Face (all pipelines)
# HF_HOME=/path/to/hf-cache          # where model weights are cached
# HF_TOKEN=hf_xxx                    # optional: higher download rate limits
# HF_HUB_OFFLINE=1                   # use only already-cached models (no network)
# CUDA_VISIBLE_DEVICES=0             # pick a GPU; CPU is used when none is available

# ---------------------------------------------------------------- Tests
# RUN_LLM_TESTS=1                    # enable the opt-in real FLAN-T5 test in RAG_Pipeline_Graph/tests
